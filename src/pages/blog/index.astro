---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased">
    <Header />

    <main class="max-w-6xl mx-auto px-4 py-12">
      <!-- Título -->
      <header class="mb-12 text-center">
        <h1 class="text-4xl font-extrabold text-slate-900 mb-4">Blog</h1>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Publicaciones académicas sobre lógica formal, pruebas de software,
          expresiones cuantificadoras y fundamentos de programación en Java.
        </p>
      </header>

      <!-- Listado de posts -->
      <section class="grid gap-10 md:grid-cols-2">
        {
          posts.map((post) => (
            <article class="bg-white rounded-2xl shadow-sm hover:shadow-md transition overflow-hidden">
              <a href={`/blog/${post.id}/`} class="block h-full">
                {post.data.heroImage && (
                  <Image
                    src={post.data.heroImage}
                    alt=""
                    class="w-full h-56 object-cover"
                  />
                )}

                <div class="p-6">
                  <p class="text-sm text-slate-500 mb-2">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  <h2 class="text-xl font-semibold text-slate-900 mb-2">
                    {post.data.title}
                  </h2>
                  <p class="text-slate-600 text-sm">
                    {post.data.description}
                  </p>
                </div>
              </a>
            </article>
          ))
        }
      </section>
    </main>

    <Footer />
  </body>
</html>
