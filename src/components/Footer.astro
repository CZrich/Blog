---
const today = new Date();
---

<footer class="bg-white text-slate-600 mt-24 border-t border-slate-100">
    <div class="max-w-3xl mx-auto px-6 py-12"> <div class="flex flex-col items-center gap-4 text-center">
            
            <p class="text-base font-medium text-slate-800">
                Gracias por leer <span class="text-red-500 animate-pulse">❤️</span>
            </p>

            <div class="space-y-1">
                <p class="text-sm tracking-tight">
                    © {today.getFullYear()} · Blog de Aspectos Formales
                </p>
                <p class="text-xs text-slate-400 uppercase tracking-widest font-bold">
                    Proyecto Académico · Universidad
                </p>
            </div>
        </div>

        <div class="mt-10 pt-6 border-t border-slate-50 text-center">
            <p class="text-xs text-slate-400 italic">
                Curso: Aspectos Formales de Especificación y Verificación
            </p>
        </div>
    </div>
</footer>